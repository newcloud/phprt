#!/usr/bin/env bash
# =============================================================================
#  myphp —— 由 phprt 生成（模板：lib/myphp-project.tmpl）
#
#  这个文件就是「本项目的 PHP 运行环境」：版本、php.ini、额外参数全固化成
#  明文，cat 一眼就能看见，可以跟着项目一起进 git。想换版本/换 ini 就改这里
#  （或者重新跑 phprt init）。
#
#    ./myphp -v
#    ./myphp worker.php
#    ./myphp composer install
# =============================================================================
set -euo pipefail

# 安装根（项目内安装时是相对路径，整个项目搬走也能用）
PHPRT_ROOT="@PHPRT_ROOT@"
PHPRT_PHP="@PHP_VERSION@"

# 本项目的 php.ini：留空则用安装根里的默认 php.ini
PHPRT_INI="@PHP_INI@"

# 额外的 php 参数，比如 -d memory_limit=512M / -c /some/php.ini
PHPRT_ARGS=(@PHP_ARGS@)

APP_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"

case "$PHPRT_ROOT" in
  /*) ;;
  *)  PHPRT_ROOT="$APP_DIR/${PHPRT_ROOT#./}" ;;
esac

# ini 写相对路径时按项目目录算，这样从别的目录调用（RoadRunner 之类）也照样对
if [ -n "$PHPRT_INI" ]; then
  case "$PHPRT_INI" in
    /*) ;;
    *)  PHPRT_INI="$APP_DIR/${PHPRT_INI#./}" ;;
  esac
  export PHPRC="$PHPRT_INI"
fi

exec "$PHPRT_ROOT/bin/myphp-$PHPRT_PHP" ${PHPRT_ARGS[@]+"${PHPRT_ARGS[@]}"} "$@"
