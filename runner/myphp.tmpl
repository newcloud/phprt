#!/usr/bin/env bash
# 由 phprt 生成：本项目的 PHP 入口。
# 版本切换只改 .phprt/current 符号链接，这个文件不用动。
# 依赖库已用 $ORIGIN rpath，不需要 LD_LIBRARY_PATH。
set -euo pipefail

PHPRT_ROOT=".phprt"
PHPRT_INI=".phprt/php.ini"

# 自身所在目录：纯参数展开，只起一次子进程
_src="${BASH_SOURCE[0]}"
case "$_src" in */*) _dir="${_src%/*}" ;; *) _dir="." ;; esac
APP_DIR="$(cd -P "$_dir" && pwd)"

case "$PHPRT_ROOT" in
  /*) ;;
  *)  PHPRT_ROOT="$APP_DIR/${PHPRT_ROOT#./}" ;;
esac
case "$PHPRT_INI" in
  /*) ;;
  *)  PHPRT_INI="$APP_DIR/${PHPRT_INI#./}" ;;
esac

PREFIX="$PHPRT_ROOT/current"
if [ ! -x "$PREFIX/bin/php" ]; then
  echo "PHP 未安装: $PREFIX/bin/php" >&2
  echo "（先跑 phprt set <版本>）" >&2
  exit 1
fi
if [ ! -f "$PHPRT_INI" ]; then
  echo "缺少 php.ini: $PHPRT_INI" >&2
  echo "（先跑 phprt set <版本> 重新生成）" >&2
  exit 1
fi

export PHPRC="$PHPRT_INI"
export PHP_INI_SCAN_DIR="$PREFIX/etc/conf.d:$PHPRT_ROOT/conf.d"
case ":$PATH:" in
  *":$PREFIX/bin:"*) ;;
  *) PATH="$PREFIX/bin:$PATH" ;;
esac
export PATH

EXT_DIR=""
for d in "$PREFIX"/lib/php/extensions/*/; do
  [ -d "$d" ] && { EXT_DIR="${d%/}"; break; }
done

if [ -z "${OPENSSL_CONF:-}" ] && [ -f "$PREFIX/etc/ssl/openssl.cnf" ]; then
  export OPENSSL_CONF="$PREFIX/etc/ssl/openssl.cnf"
fi

ARGS=()
[ -n "$EXT_DIR" ] && ARGS=(-d "extension_dir=$EXT_DIR")

case "${1:-}" in
  --env)
    printf 'PHP=%s\nPHPRC=%s\nPHP_INI_SCAN_DIR=%s\nEXT_DIR=%s\nOPENSSL_CONF=%s\n' \
      "$PREFIX/bin/php" "$PHPRC" "$PHP_INI_SCAN_DIR" "$EXT_DIR" "${OPENSSL_CONF:-}"
    exit 0 ;;
  --shell)
    printf 'export PHPRC=%q\n' "$PHPRC"
    printf 'export PHP_INI_SCAN_DIR=%q\n' "$PHP_INI_SCAN_DIR"
    printf 'export PATH=%q\n' "$PATH"
    if [ -n "${OPENSSL_CONF:-}" ]; then
      printf 'export OPENSSL_CONF=%q\n' "$OPENSSL_CONF"
    fi
    if [ -n "$EXT_DIR" ]; then
      printf 'php() { command %q -d %q "$@"; }\n' "$PREFIX/bin/php" "extension_dir=$EXT_DIR"
    fi
    exit 0 ;;
esac

exec "$PREFIX/bin/php" "${ARGS[@]}" "$@"
