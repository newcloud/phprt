# 仓库里只有代码；编译产物和源码包都不进 git
*.log

# 源码包：downloads/ 只保留说明和校验清单
downloads/**
!downloads/README.md
!downloads/SHA256SUMS

# 在仓库根直接跑 phprt 时可能生成的项目目录
/.phprt/

# chroot 构建环境（scripts/setup-build-chroot.sh 生成的产物，不进 git）
/buildroot/
/.buildroot.lock
/enter-build-chroot.sh
/unmount-build-chroot.sh
/.buildroot.lock
