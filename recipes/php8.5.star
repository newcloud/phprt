# PHP 8.5 的内置扩展事实。
#
# builtin_exts：PHP 8.5 源码 ext/ 下的内置扩展。只从这里推导 ext 的 origin，
#               和当前是否已有 recipe 无关。
# builtin_disable：phprt 需要显式关闭的内置扩展 -> 对应的 configure 关闭参数。
#               选中 static 时会跳过对应的关闭参数，改用 ext recipe 的 configure。
#               不在这里的扩展保持 PHP 默认或 php recipe 里的 --enable-*。
BUILTIN_EXTS = [
        "bcmath",
        "bz2",
        "calendar",
        "com_dotnet",
        "ctype",
        "curl",
        "date",
        "dba",
        "dl_test",
        "dom",
        "enchant",
        "exif",
        "ffi",
        "fileinfo",
        "filter",
        "ftp",
        "gd",
        "gettext",
        "gmp",
        "hash",
        "iconv",
        "imap",
        "intl",
        "json",
        "ldap",
        "lexbor",
        "libxml",
        "mbstring",
        "mysqli",
        "mysqlnd",
        "odbc",
        "opcache",
        "openssl",
        "pcntl",
        "pcre",
        "pdo",
        "pdo_dblib",
        "pdo_firebird",
        "pdo_mysql",
        "pdo_odbc",
        "pdo_pgsql",
        "pdo_sqlite",
        "pgsql",
        "phar",
        "posix",
        "random",
        "readline",
        "reflection",
        "session",
        "shmop",
        "simplexml",
        "snmp",
        "soap",
        "sockets",
        "sodium",
        "spl",
        "sqlite3",
        "standard",
        "sysvmsg",
        "sysvsem",
        "sysvshm",
        "tidy",
        "tokenizer",
        "uri",
        "xml",
        "xmlreader",
        "xmlwriter",
        "xsl",
        "zend_test",
        "zip",
        "zlib",
]

BUILTIN_DISABLE = {
        "openssl": "--without-openssl",
        "curl": "--without-curl",
        "libxml": "--without-libxml",
        "dom": "--disable-dom",
        "simplexml": "--disable-simplexml",
        "xml": "--disable-xml",
        "xmlreader": "--disable-xmlreader",
        "xmlwriter": "--disable-xmlwriter",
        "sqlite3": "--without-sqlite3",
        "pdo_sqlite": "--without-pdo-sqlite",
        "zlib": "--without-zlib",
}

TARGET = php(
    series = "8.5",
    builtin_exts = BUILTIN_EXTS,
    builtin_disable = BUILTIN_DISABLE,
    configure = [
        "--prefix={tree}",
        "--with-config-file-path={tree}/etc",
        "--with-config-file-scan-dir={tree}/etc/conf.d",
        "--enable-cli",
        "--disable-cgi",
        "--without-pear",
        "--enable-filter",
        "--enable-phar",
        "--enable-fileinfo",
        "--enable-bcmath",
        "--enable-calendar",
        "--enable-exif",
    ],
    make = ["make", "make install"],
    artifacts = ["bin/php"],
    desc = "PHP 8.5 本体",
)
