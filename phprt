#!/usr/bin/env bash
# =============================================================================
#  phprt —— 管理命令（装在仓库里，不复制进安装根）
#
#    phprt list                 已安装的 PHP 版本 + 当前项目用的入口
#    phprt init                 在当前目录生成 ./myphp（版本 + php.ini 固化进去）
#    phprt exec -- <参数>        不建项目，直接跑一下 PHP
#    phprt build [参数...]       编译/增量（参数见 ./build.sh --help）
#    phprt verify               安装结果自检
#    phprt clean [--all]        清 build/（--all 连 downloads/）
#    phprt home                 打印当前使用的安装根
# =============================================================================
set -euo pipefail

HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
VERSIONS_DIR="$HERE/lib/versions"

die() { printf '\033[1;31m错误:\033[0m %s\n' "$*" >&2; exit 1; }
say() { printf '\033[1;36m==>\033[0m %s\n' "$*"; }
good() { printf '\033[1;32m  ok\033[0m %s\n' "$*"; }

# 安装根：环境变量 > 从当前目录往上找 .phprt > ~/.phprt
find_home() {
  if [ -n "${PHPRT_HOME:-}" ]; then
    printf '%s\n' "${PHPRT_HOME%/}"; return
  fi
  local d="$PWD"
  while :; do
    if [ -f "$d/.phprt/config.conf" ]; then printf '%s\n' "$d/.phprt"; return; fi
    [ "$d" = "/" ] && break
    d="$(dirname "$d")"
  done
  printf '%s\n' "$HOME/.phprt"
}

installed_versions() { # 已安装的版本，按版本号从新到旧
  local h="$1" d
  for d in "$h"/php-*; do
    [ -x "$d/bin/php" ] || continue
    [ -f "$d/.phprt-stamp-php" ] || continue
    basename "$d" | sed 's/^php-//'
  done | sort -Vr
}

latest_installed() {
  installed_versions "$1" | head -1
}

cmd_list() {
  local h; h="$(find_home)"
  printf '安装根: %s\n' "$h"
  [ -d "$h" ] || { printf '  （还没安装，先跑 ./install.sh）\n'; return 0; }

  local vers; vers="$(installed_versions "$h")"
  if [ -z "$vers" ]; then
    printf '  还没有编译好的 PHP 版本\n'
  else
    printf '\n%-12s %s\n' "版本" "路径"
    local v
    while IFS= read -r v; do
      [ -n "$v" ] || continue
      printf '%-12s %s\n' "$v" "$h/php-$v"
    done <<< "$vers"
    local inis
    inis="$(ls -1 "$h"/php*_*.ini 2>/dev/null | xargs -rn1 basename 2>/dev/null | tr '\n' ' ')"
    [ -n "$inis" ] && printf '\nini: %s\n' "$inis"
    printf '\n'
  fi

  # 当前项目用什么（软链优先判断：-f 会跟随软链）
  if [ -L "$PWD/myphp" ]; then
    printf '当前项目: ./myphp -> %s（旧式软链）\n' "$(readlink "$PWD/myphp")"
  elif [ -f "$PWD/myphp" ]; then
    printf '当前项目: %s/myphp\n' "$PWD"
    sed -n 's/^PHPRT_PHP=/  PHP=/p; s/^PHPRT_INI=/  ini=/p; s/^PHPRT_ROOT=/  root=/p' "$PWD/myphp"
  fi

  # 磁盘占用
  local sizes
  sizes="$(du -sh "$h" 2>/dev/null | cut -f1)"
  [ -n "$sizes" ] && printf '\n占用: %s（%s）\n' "$sizes" "$h"
  return 0
}

render_app() { # render_app <out> <root> <php> <ini> <args>
  local out="$1" tpl
  tpl="$(cat "$HERE/lib/myphp-project.tmpl")"
  tpl="${tpl//@PHPRT_ROOT@/$2}"
  tpl="${tpl//@PHP_VERSION@/$3}"
  tpl="${tpl//@PHP_INI@/$4}"
  tpl="${tpl//@PHP_ARGS@/$5}"
  printf '%s\n' "$tpl" > "$out.tmp"
  chmod +x "$out.tmp"
  mv -f "$out.tmp" "$out"
}

cmd_init() {
  local h; h="$(find_home)"
  local ver="" ini="default" ini_local=0 name="myphp" force=0

  while [ $# -gt 0 ]; do
    case "$1" in
      --php)       ver="${2:-}"; shift 2 ;;
      --php=*)     ver="${1#*=}"; shift ;;
      --ini)       ini="${2:-}"; shift 2 ;;
      --ini=*)     ini="${1#*=}"; shift ;;
      --ini-local) ini_local=1; shift ;;
      --name)      name="${2:-}"; shift 2 ;;
      --name=*)    name="${1#*=}"; shift ;;
      --root)      h="${2:-}"; shift 2 ;;
      --root=*)    h="${1#*=}"; shift ;;
      --force)     force=1; shift ;;
      *) die "未知参数: $1" ;;
    esac
  done

  [ -d "$h" ] || die "安装根不存在: $h（先跑 install.sh）"
  local vers; vers="$(installed_versions "$h")"
  if [ -z "$vers" ]; then
    die "$h 里没有编译好的 PHP（先跑 install.sh）"
  fi
  if [ -z "$ver" ]; then
    ver="$(latest_installed "$h")"
  fi
  printf '%s\n' "$vers" | grep -qx "$ver" || die "没装 PHP $ver（已装: $(printf '%s' "$vers" | tr '\n' ' ')）"

  local app="$PWD/$name"
  if [ -L "$app" ]; then
    [ "$force" = 1 ] || die "$app 是个软链，先删掉或加 --force"
    rm -f "$app"
  elif [ -f "$app" ] && ! head -3 "$app" | grep -q '由 phprt 生成'; then
    [ "$force" = 1 ] || die "$app 已存在且不是 phprt 生成的（加 --force 覆盖）"
  fi

  # 安装根在项目里就用相对路径
  local root_value="$h"
  case "$h/" in
    "$PWD"/*) root_value="./${h#"$PWD"/}" ;;
  esac

  # ini
  local ini_value="" preset=""
  case "$ini" in
    default|dev|prod) preset="$ini" ;;
    *) [ -f "$ini" ] || die "ini 文件不存在: $ini"; ini_value="$ini" ;;
  esac
  if [ -n "$preset" ] && [ "$ini_local" = 1 ]; then
    local src="$HERE/ini/$preset.ini"
    [ -f "$src" ] || src="$h/php${ver}_${preset}.ini"
    [ -f "$src" ] || die "找不到预设 ini: $preset"
    cp -f "$src" "$PWD/php.ini"
    ini_value="./php.ini"
    good "php.ini -> $PWD/php.ini（来自 $preset）"
  elif [ -n "$preset" ]; then
    ini_value="$h/php${ver}_${preset}.ini"
    [ -f "$ini_value" ] || die "缺少 $ini_value（先 phprt build）"
  fi

  # ini 落在项目里就写相对路径（和 PHPRT_ROOT 保持一致），项目整体搬走也能用
  if [ -n "$ini_value" ]; then
    case "$ini_value/" in
      "$PWD"/*) ini_value="./${ini_value#"$PWD"/}" ;;
    esac
  fi

  render_app "$app" "$root_value" "$ver" "$ini_value" ""
  good "$app  PHP=$ver ${ini_value:+ini=$ini_value}"
  printf '  用法: ./%s -v\n' "$name"
}

cmd_exec() {
  local h; h="$(find_home)"
  local ver="" ini=""

  while [ $# -gt 0 ]; do
    case "$1" in
      --root)   h="${2:-}"; shift 2 ;;
      --root=*) h="${1#*=}"; shift ;;
      --php)    ver="${2:-}"; shift 2 ;;
      --php=*)  ver="${1#*=}"; shift ;;
      --ini)    ini="${2:-}"; shift 2 ;;
      --ini=*)  ini="${1#*=}"; shift ;;
      --)       shift; break ;;
      -*)       die "未知参数: $1（php 自己的参数放在 -- 之后）" ;;
      *)        break ;;
    esac
  done

  [ -d "$h" ] || die "安装根不存在: $h（先跑 install.sh）"
  [ -n "$ver" ] || ver="$(latest_installed "$h")"
  [ -n "$ver" ] || die "$h 里没有编译好的 PHP（先跑 install.sh）"
  local prefix="$h/php-$ver"
  [ -x "$prefix/bin/php" ] || die "没装 PHP $ver（已装: $(installed_versions "$h" | tr '\n' ' ')）"

  case "$ini" in
    "")             ini="$h/php${ver}_default.ini"
                    [ -f "$ini" ] || ini="$prefix/etc/php.ini" ;;
    default)        ini="$h/php${ver}_default.ini" ;;
    dev|prod)       ini="$h/php${ver}_${ini}.ini" ;;
    *)              [ -f "$ini" ] || die "ini 文件不存在: $ini" ;;
  esac
  [ -f "$ini" ] || die "ini 不存在: $ini"

  local d ld="" ext=""
  for d in "$h"/deps/*/lib; do [ -d "$d" ] && ld+="$d:"; done
  for d in "$prefix"/lib/php/extensions/*/; do [ -d "$d" ] && { ext="${d%/}"; break; }; done

  export PHPRC="${ini:-$prefix/etc/php.ini}"
  export PHP_INI_SCAN_DIR="$prefix/etc/conf.d"
  export LD_LIBRARY_PATH="${ld%:}${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
  for d in "$h"/deps/openssl-*/etc/ssl/openssl.cnf; do
    [ -f "$d" ] && { export OPENSSL_CONF="$d"; break; }
  done

  local pargs=()
  [ -n "$ext" ] && pargs=(-d "extension_dir=$ext")

  if [ "${1:-}" = "composer" ]; then
    shift
    [ -f "$h/composer.phar" ] || die "Composer 未安装（先 phprt build）"
    exec "$prefix/bin/php" ${pargs[@]+"${pargs[@]}"} "$h/composer.phar" "$@"
  fi

  exec "$prefix/bin/php" ${pargs[@]+"${pargs[@]}"} "$@"
}

cmd_build()   { PHPRT_HOME="$(find_home)" exec bash "$HERE/build.sh" "$@"; }
cmd_verify()  { PHPRT_HOME="$(find_home)" exec bash "$HERE/lib/verify.sh" "$@"; }

cmd_clean() {
  local all=0
  [ "${1:-}" = "--all" ] && all=1
  local h; h="$(find_home)"
  if [ -d "$h/build" ]; then
    say "删除 $h/build"
    rm -rf "${h:?}/build"/*
  fi
  if [ "$all" = 1 ] && [ -d "$h/downloads" ]; then
    say "删除 $h/downloads"
    rm -rf "${h:?}/downloads"/*
  fi
  good "已清理"
}

main() {
  local cmd="${1:-}"
  [ $# -gt 0 ] && shift
  case "$cmd" in
    list|ls)        cmd_list ;;
    init)           cmd_init "$@" ;;
    exec)           cmd_exec "$@" ;;
    build)          cmd_build "$@" ;;
    verify)         cmd_verify "$@" ;;
    clean)          cmd_clean "$@" ;;
    home)           find_home ;;
    ""|-h|--help)   awk 'NR>1 && /^#/ {sub(/^# ?/, ""); print; next} NR>1 {exit}' "$0" ;;
    --version|-V)   printf 'phprt (repo %s)\n' "$HERE" ;;
    *)              die "未知子命令: $cmd（--help 查看用法）" ;;
  esac
}

main "$@"
