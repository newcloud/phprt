#!/usr/bin/env bash
# phprt 入口：在仓库里运行，或复制到 <项目>/.phprt/bin/phprt 后运行。
set -euo pipefail

HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
RUNNER="$HERE/runner"
[ -d "$RUNNER" ] || RUNNER="$HERE"

# 复制到项目后，.phprt/config 记录原始仓库位置
if [ -f "$HERE/../config" ] && [ -z "${PHPRT_REPO:-}" ]; then
  # shellcheck disable=SC1091
  . "$HERE/../config"
fi

# 仓库根带 bundles/；项目里的副本靠 PHPRT_REPO 找回来
if [ -d "$HERE/bundles" ] && [ -z "${PHPRT_REPO:-}" ]; then
  PHPRT_REPO="$HERE"
fi
export PHPRT_REPO="${PHPRT_REPO:-}"

# buildroot 子命令：交给独立脚本，不加载 runner（./phprt buildroot ...）
if [ "${1:-}" = "buildroot" ]; then
  shift
  BR="$HERE/scripts/buildroot.sh"
  [ -x "$BR" ] || BR="${PHPRT_REPO:-}/scripts/buildroot.sh"
  [ -x "$BR" ] || { echo "错误: 找不到 scripts/buildroot.sh（该命令只能在 phprt 仓库里用）" >&2; exit 1; }
  exec "$BR" "$@"
fi

# shellcheck disable=SC1091
. "$RUNNER/common.sh"
# shellcheck disable=SC1091
. "$RUNNER/commands.sh"

main "$@"
